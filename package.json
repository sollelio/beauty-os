{
  "name": "beauty-os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:supabase": "node scripts/check-supabase.mjs",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "android:check": "node scripts/check-android-bundle.mjs",
    "android:sync:dev": "tsc -b && vite build --mode android-dev && cap sync android && node scripts/check-android-bundle.mjs dev",
    "android:sync:prod": "tsc -b && vite build --mode android-prod && cap sync android && node scripts/check-android-bundle.mjs prod"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "supabase": "^2.120.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
